# Database Configuration
# Local par ye 'jdbc:mysql://localhost:3306/your_db_name' hoga
DB_URL=jdbc:mysql://localhost:3306/fooddelivery
DB_USERNAME=your_username
DB_PASSWORD=your_password

# JPA / Hibernate Settings
# Options: update, create, validate, none
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Security
# Kam se kam 64 characters ki random hex string use karein
JWT_SECRET_KEY=generate_a_random_64_char_hex_string_here